{
  "name": "lux-web3",
  "version": "1.0.0",
  "description": "The lux web3 project",
  "scripts": {
    "ci:all": "npm install && run-p --print-label ci:contracts ci:frontend",
    "ci:contracts": "cd contracts && npm install",
    "ci:frontend": "cd frontend && npm install",
    "contracts:node": "cd contracts && npm run node",
    "contracts:deploy-local": "cd contracts && npm run deploy:local",
    "contracts:deploy-when-ready": "wait-on tcp:127.0.0.1:8545 && npm run contracts:deploy-local",
    "dev:contracts": "run-p --print-label contracts:node contracts:deploy-when-ready",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "run-p --print-label dev:contracts dev:frontend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theotime2005/lux-web3.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/theotime2005/lux-web3/issues"
  },
  "homepage": "https://github.com/theotime2005/lux-web3#readme",
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "wait-on": "^9.0.4"
  }
}
